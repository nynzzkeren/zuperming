<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zuperming · Access Portal</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        
        body {
            margin: 0;
            padding: 0;
            background-color: #000000;
            background-image: 
                radial-gradient(circle at 15% 50%, rgba(30, 41, 59, 0.4), transparent 30%),
                radial-gradient(circle at 85% 30%, rgba(15, 23, 42, 0.6), transparent 30%);
            color: #f1f5f9;
            font-family: 'Inter', -apple-system, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            overflow: hidden;
            position: relative;
        }

        /* Ambient grid overlay */
        body::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: 
                linear-gradient(to right, #1e293b 1px, transparent 1px),
                linear-gradient(to bottom, #1e293b 1px, transparent 1px);
            background-size: 40px 40px;
            opacity: 0.15;
            z-index: 0;
            pointer-events: none;
        }

        .zp-auth-wrapper {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 380px;
            padding: 2rem;
            background: rgba(9, 9, 11, 0.65);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            backdrop-filter: blur(24px) saturate(150%);
            box-shadow: 0 0 0 1px rgba(0,0,0,0.5), 0 30px 60px rgba(0, 0, 0, 0.6);
        }

        .zp-auth-brand {
            margin-bottom: 2.5rem;
            text-align: left;
        }

        .zp-auth-brand-logo {
            font-family: 'JetBrains Mono', monospace;
            font-weight: 700;
            font-size: 1.125rem;
            letter-spacing: -0.02em;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .zp-auth-brand-logo::before {
            content: '';
            display: block;
            width: 16px;
            height: 16px;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            border-radius: 4px;
        }

        .zp-auth-title {
            font-size: 1.5rem;
            font-weight: 600;
            letter-spacing: -0.03em;
            margin: 0 0 0.5rem;
            color: #ffffff;
        }

        .zp-auth-subtitle {
            font-size: 0.875rem;
            color: #94a3b8;
            margin: 0;
            line-height: 1.5;
        }

        .zp-auth-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            width: 100%;
            padding: 0.75rem 1rem;
            background-color: #ffffff;
            color: #0f172a;
            border: none;
            border-radius: 6px;
            font-family: 'Inter', sans-serif;
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s ease;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
        }

        .zp-auth-btn:hover {
            background-color: #f8fafc;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(255, 255, 255, 0.1);
        }

        .zp-auth-btn:active {
            transform: translateY(0);
        }

        .zp-auth-btn svg {
            width: 18px;
            height: 18px;
            fill: #5865F2; /* Discord brand color for the icon only */
        }

        .zp-auth-divider {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 1.5rem 0;
        }
        
        .zp-auth-divider::before,
        .zp-auth-divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .zp-auth-divider span {
            padding: 0 0.75rem;
            color: #64748b;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 500;
        }

        .zp-auth-error {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.2);
            color: #fca5a5;
            padding: 0.75rem;
            border-radius: 6px;
            font-size: 0.875rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: flex-start;
            gap: 0.5rem;
        }

        .zp-auth-error::before {
            content: '⚠️';
            font-size: 1rem;
        }

        .zp-auth-footer {
            margin-top: 2rem;
            font-size: 0.75rem;
            color: #475569;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="zp-auth-wrapper">
        <div class="zp-auth-brand">
            <div class="zp-auth-brand-logo">ZUPERMING</div>
        </div>
        
        <h1 class="zp-auth-title">Access Portal</h1>
        <p class="zp-auth-subtitle">Protected system environment. Developer and Owner credentials required for entry.</p>
        
        <div class="zp-auth-divider">
            <span>Authenticate</span>
        </div>

        <% if (error) { %>
            <div class="zp-auth-error"><%= error %></div>
        <% } %>

        <a href="/admin/auth/discord" class="zp-auth-btn">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
            Continue with Discord
        </a>
        
        <div class="zp-auth-footer">
            System Instance v2.4.1
        </div>
    </div>
</body>
</html>
