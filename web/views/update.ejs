<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ping Update · Zuperming</title>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Orbitron:wght@500;700&family=Space+Grotesk:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --panel: rgba(8, 12, 28, 0.78);
            --border: rgba(59, 130, 246, 0.22);
            --text: #e8eefc;
            --muted: #8b9bc4;
            --blue: #3b82f6;
            --blue-bright: #60a5fa;
            --magenta: #e11d8f;
            --danger: #f87171;
            --ok: #34d399;
            --bg-image: url('https://cdn.discordapp.com/attachments/1482305764315107423/1532727199881363637/1783999829490.png?ex=6a6de6f1&is=6a6c9571&hm=0f7b740f2385acefcefdd24820f12617d61f6bd4158355a494e856172da7bbd5');
        }
        * { box-sizing: border-box; }
        body {
            font-family: 'Space Grotesk', sans-serif;
            background:
                linear-gradient(145deg, rgba(5,7,15,0.92), rgba(10,20,55,0.88), rgba(18,8,30,0.9)),
                var(--bg-image) center / cover no-repeat fixed;
            color: var(--text);
            margin: 0;
            min-height: 100vh;
        }
        .sidebar {
            width: 250px;
            height: 100vh;
            background: rgba(6, 10, 24, 0.92);
            backdrop-filter: blur(12px);
            position: fixed;
            border-right: 1px solid var(--border);
            padding-top: 30px;
            z-index: 20;
        }
        .sidebar h2 {
            text-align: center;
            font-family: 'Orbitron', sans-serif;
            background: linear-gradient(90deg, var(--blue-bright), #a78bfa, var(--magenta));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 40px;
        }
        .sidebar a {
            display: block;
            padding: 15px 25px;
            color: var(--muted);
            text-decoration: none;
            font-weight: 600;
        }
        .sidebar a:hover, .sidebar a.active {
            background: linear-gradient(90deg, rgba(59,130,246,0.18), rgba(225,29,143,0.08));
            color: var(--blue-bright);
            border-left: 3px solid var(--blue);
        }
        .sidebar a.logout { color: var(--danger); position: absolute; bottom: 20px; width: 100%; border: none; }
        .menu-toggle {
            display: none;
            position: fixed;
            top: 14px; left: 14px;
            z-index: 30;
            background: rgba(6,10,24,0.95);
            border: 1px solid var(--border);
            color: var(--text);
            border-radius: 10px;
            padding: 10px 14px;
            font-weight: 700;
        }
        .content { margin-left: 250px; padding: 40px; }
        .card {
            background: var(--panel);
            backdrop-filter: blur(10px);
            padding: 28px;
            border-radius: 14px;
            border: 1px solid var(--border);
            margin-bottom: 24px;
            max-width: 820px;
        }
        label { display: block; font-weight: 600; margin: 14px 0 8px; color: var(--muted); font-size: 0.9em; }
        input[type="text"], textarea, select {
            width: 100%;
            background: rgba(5, 10, 24, 0.9);
            color: var(--text);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 12px 14px;
            font-family: 'JetBrains Mono', monospace;
        }
        textarea { min-height: 90px; resize: vertical; }
        .checks { display: flex; gap: 18px; flex-wrap: wrap; margin-top: 8px; }
        .checks label { margin: 0; color: var(--text); font-weight: 600; display: flex; gap: 8px; align-items: center; }
        button {
            margin-top: 18px;
            padding: 12px 22px;
            background: linear-gradient(90deg, #2563eb, #7c3aed);
            color: white;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 700;
            font-family: inherit;
        }
        .msg, .err { padding: 14px; border-radius: 10px; margin-bottom: 18px; font-weight: 600; }
        .msg { background: rgba(52,211,153,0.12); color: #6ee7b7; border: 1px solid rgba(52,211,153,0.35); }
        .err { background: rgba(248,113,113,0.12); color: #fecaca; border: 1px solid rgba(248,113,113,0.35); }
        .hint { color: var(--muted); line-height: 1.6; }
        @media (max-width: 900px) {
            .menu-toggle { display: block; }
            .sidebar {
                transform: translateX(-105%);
                transition: transform 0.25s ease;
                height: 100%;
            }
            .sidebar.open { transform: translateX(0); }
            .sidebar a.logout { position: static; margin-top: 30px; }
            .content { margin-left: 0; padding: 70px 16px 24px; }
        }
    </style>
</head>
<body>
    <button class="menu-toggle" type="button" onclick="document.querySelector('.sidebar').classList.toggle('open')">Menu</button>
    <div class="sidebar">
        <h2>ZUPERMING</h2>
        <a href="/admin">Dashboard</a>
        <a href="/admin/script">Script · Premium</a>
        <a href="/admin/script/sp">Script · Service Provider</a>
        <a href="/admin/update" class="active">Ping Update</a>
        <a href="/admin/logout" class="logout">Logout</a>
    </div>

    <div class="content">
        <h1 style="margin-top:0;">Ping Update</h1>
        <p class="hint">Kosongkan Added / Improved / Removed → section itu tidak ikut di Discord.</p>

        <% if (message) { %><div class="msg"><%= message %></div><% } %>
        <% if (error) { %><div class="err"><%= error %></div><% } %>

        <div class="card">
            <form action="/admin/update" method="POST">
                <label>Game</label>
                <input type="text" name="game" placeholder="Fisch" required>

                <label>Type (whitelist)</label>
                <div class="checks">
                    <label><input type="checkbox" name="types" value="Premium" checked> Premium</label>
                    <label><input type="checkbox" name="types" value="Service Provider"> Service Provider</label>
                </div>

                <label>Version</label>
                <input type="text" name="version" placeholder="1.4" required>

                <label>Status</label>
                <input type="text" name="status" placeholder="Undetected" value="Undetected">

                <label>Added (optional, 1 baris = 1 item)</label>
                <textarea name="added" placeholder="New Auto Farm&#10;New UI"></textarea>

                <label>Improved (optional)</label>
                <textarea name="improved" placeholder="Fix Not Load&#10;Improved Cast"></textarea>

                <label>Removed (optional)</label>
                <textarea name="removed" placeholder="Old ESP"></textarea>

                <label>Channel ID (kosong = UPDATE_CHANNEL_ID di .env)</label>
                <input type="text" name="channel_id" placeholder="Discord channel ID" value="<%= defaultChannel || '' %>">

                <div class="checks" style="margin-top:16px;">
                    <label><input type="checkbox" name="ping_everyone" value="on"> Ping @everyone</label>
                </div>

                <button type="submit">Post Change Log</button>
            </form>
        </div>
    </div>
</body>
</html>
