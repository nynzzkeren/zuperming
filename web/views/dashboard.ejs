<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zuperming · Console</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        
        :root {
            --bg-base: #000000;
            --bg-panel: #0a0a0a;
            --bg-elevated: #111111;
            --border-subtle: #222222;
            --border-focus: #333333;
            --text-primary: #ededed;
            --text-secondary: #a1a1aa;
            --accent-brand: #ffffff;
            --accent-blue: #3b82f6;
            --accent-green: #22c55e;
            --accent-red: #ef4444;
            --font-sans: 'Inter', -apple-system, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }

        body {
            margin: 0;
            padding: 0;
            background-color: var(--bg-base);
            color: var(--text-primary);
            font-family: var(--font-sans);
            font-size: 14px;
            display: flex;
            height: 100vh;
            overflow: hidden;
            background-image: 
                linear-gradient(to right, rgba(255,255,255,0.02) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255,255,255,0.02) 1px, transparent 1px);
            background-size: 40px 40px;
        }

        /* --- LAYOUT --- */
        .zp-layout__sidebar {
            width: 260px;
            background-color: var(--bg-panel);
            border-right: 1px solid var(--border-subtle);
            display: flex;
            flex-direction: column;
            z-index: 10;
        }
        
        .zp-layout__main {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
        }
        
        .zp-layout__content {
            flex: 1;
            overflow-y: auto;
            padding: 2.5rem 3rem;
        }

        /* --- HEADER --- */
        .zp-header {
            height: 56px;
            border-bottom: 1px solid var(--border-subtle);
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(12px);
            display: flex;
            align-items: center;
            padding: 0 3rem;
            position: sticky;
            top: 0;
            z-index: 20;
        }

        .zp-header__breadcrumbs {
            font-size: 13px;
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .zp-header__breadcrumbs span.active {
            color: var(--text-primary);
            font-weight: 500;
        }

        /* --- SIDEBAR COMPONENTS --- */
        .zp-brand {
            height: 56px;
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            font-family: var(--font-mono);
            font-weight: 700;
            font-size: 14px;
            letter-spacing: -0.02em;
            border-bottom: 1px solid var(--border-subtle);
        }
        
        .zp-brand::before {
            content: '';
            display: inline-block;
            width: 12px;
            height: 12px;
            background: var(--text-primary);
            border-radius: 2px;
            margin-right: 10px;
        }

        .zp-nav {
            padding: 1.5rem 0.75rem;
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex: 1;
        }

        .zp-nav__item {
            display: flex;
            align-items: center;
            padding: 8px 12px;
            color: var(--text-secondary);
            text-decoration: none;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .zp-nav__item:hover {
            color: var(--text-primary);
            background-color: var(--bg-elevated);
        }

        .zp-nav__item--active {
            color: var(--text-primary);
            background-color: var(--border-subtle);
        }

        .zp-nav__footer {
            padding: 1rem;
            border-top: 1px solid var(--border-subtle);
            font-size: 12px;
            color: var(--text-secondary);
        }

        .zp-nav__footer a {
            color: var(--text-secondary);
            text-decoration: none;
            display: block;
            margin-top: 8px;
        }
        .zp-nav__footer a:hover {
            color: var(--text-primary);
        }

        /* --- UI COMPONENTS --- */
        .zp-page-title {
            font-size: 24px;
            font-weight: 600;
            letter-spacing: -0.04em;
            margin: 0 0 8px 0;
            color: var(--text-primary);
        }

        .zp-page-desc {
            color: var(--text-secondary);
            margin: 0 0 2rem 0;
            font-size: 14px;
        }

        .zp-grid-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            margin-bottom: 3rem;
        }

        .zp-stat-card {
            background: var(--bg-panel);
            border: 1px solid var(--border-subtle);
            border-radius: 8px;
            padding: 20px;
            position: relative;
            overflow: hidden;
        }

        .zp-stat-card__label {
            font-size: 12px;
            color: var(--text-secondary);
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 8px;
        }

        .zp-stat-card__value {
            font-size: 32px;
            font-weight: 600;
            font-family: var(--font-mono);
            letter-spacing: -0.05em;
        }

        .zp-panel {
            background: var(--bg-panel);
            border: 1px solid var(--border-subtle);
            border-radius: 8px;
            margin-bottom: 2rem;
            overflow: hidden;
        }
        
        .zp-panel__header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border-subtle);
            background: rgba(255,255,255,0.02);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .zp-panel__title {
            font-size: 14px;
            font-weight: 600;
            margin: 0;
        }

        .zp-panel__body {
            padding: 20px;
        }

        /* Forms & Inputs */
        .zp-input-group {
            margin-bottom: 16px;
        }
        
        .zp-input-label {
            display: block;
            font-size: 12px;
            color: var(--text-secondary);
            margin-bottom: 8px;
            font-weight: 500;
        }

        .zp-input {
            width: 100%;
            background: var(--bg-elevated);
            border: 1px solid var(--border-subtle);
            color: var(--text-primary);
            padding: 8px 12px;
            border-radius: 6px;
            font-family: var(--font-sans);
            font-size: 13px;
            outline: none;
            transition: border-color 0.15s;
        }
        .zp-input:focus { border-color: var(--text-secondary); }

        .zp-button {
            background: var(--text-primary);
            color: var(--bg-base);
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: opacity 0.15s;
        }
        .zp-button:hover { opacity: 0.9; }
        .zp-button--secondary {
            background: var(--bg-elevated);
            color: var(--text-primary);
            border: 1px solid var(--border-subtle);
        }
        .zp-button--secondary:hover { background: var(--border-focus); }

        /* Tables */
        .zp-table-wrapper {
            overflow-x: auto;
        }
        .zp-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }
        .zp-table th {
            text-align: left;
            padding: 12px 20px;
            color: var(--text-secondary);
            font-weight: 500;
            border-bottom: 1px solid var(--border-subtle);
            background: rgba(255,255,255,0.01);
        }
        .zp-table td {
            padding: 12px 20px;
            border-bottom: 1px solid var(--border-subtle);
        }
        .zp-table tr:last-child td { border-bottom: none; }
        
        .zp-mono { font-family: var(--font-mono); font-size: 12px; }
        
        .zp-badge {
            display: inline-block;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .zp-badge--neutral { background: var(--border-focus); color: var(--text-secondary); }
        .zp-badge--success { background: rgba(34, 197, 94, 0.15); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3); }
        .zp-badge--danger { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }
        .zp-badge--blue { background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3); }

        .zp-tab-pane { display: none; }
        .zp-tab-pane.is-active { display: block; }
        
        .zp-terminal {
            background: #000;
            border: 1px solid var(--border-subtle);
            border-radius: 6px;
            padding: 16px;
            font-family: var(--font-mono);
            font-size: 12px;
            color: #a1a1aa;
            white-space: pre-wrap;
            margin-top: 16px;
        }
        .zp-terminal .prompt { color: #3b82f6; }
        .zp-terminal .code { color: #e4e4e7; }
        
        .zp-avatar {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: var(--border-focus);
            display: inline-block;
            vertical-align: middle;
            margin-right: 8px;
        }

        .zp-spinner {
            border: 2px solid rgba(255,255,255,0.1);
            border-left-color: var(--accent-brand);
            border-radius: 50%;
            width: 14px;
            height: 14px;
            animation: spin 1s linear infinite;
            display: inline-block;
            margin-right: 8px;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

        .zp-file-upload-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: 10px;
            background: var(--bg-elevated);
            border: 1px dashed var(--text-secondary);
            border-radius: 6px;
            color: var(--text-secondary);
            cursor: pointer;
            font-size: 13px;
            transition: all 0.2s ease;
        }
        .zp-file-upload-btn:hover {
            border-color: var(--text-primary);
            color: var(--text-primary);
            background: rgba(255,255,255,0.05);
        }

        @media (max-width: 768px) {
            body { flex-direction: column; }
            .zp-layout__sidebar { width: 100%; height: auto; border-right: none; border-bottom: 1px solid var(--border-subtle); position: sticky; top: 0; }
            .zp-brand { justify-content: center; }
            .zp-nav { flex-direction: row; padding: 0.5rem; overflow-x: auto; white-space: nowrap; gap: 8px; }
            .zp-nav__footer { display: none; }
            .zp-layout__content { padding: 1.5rem; }
            .zp-header { display: none; }
            .zp-grid-stats { grid-template-columns: 1fr; }
            .zp-panel__body form { flex-direction: column; align-items: stretch !important; }
        }
    </style>
</head>
<body>
    <div class="zp-layout__sidebar">
        <div class="zp-brand">ZUPERMING</div>
        <div class="zp-nav">
            <a class="zp-nav__item zp-nav__item--active" onclick="switchTab('overview', this)">Overview</a>
            <a class="zp-nav__item" onclick="switchTab('projects', this)">Projects</a>
            <a class="zp-nav__item" onclick="switchTab('keys', this)">Access Keys</a>
            <a class="zp-nav__item" onclick="switchTab('logs', this)">Audit Logs</a>
            <a class="zp-nav__item" onclick="switchTab('bans', this)">Banned IPs</a>
            <a class="zp-nav__item" onclick="switchTab('dev', this)">Dev Environment</a>
        </div>
        <div class="zp-nav__footer">
            System Auth: <%- username %><br>
            <a href="/admin/logout">Terminate Session</a>
        </div>
    </div>

    <div class="zp-layout__main">
        <div class="zp-header">
            <div class="zp-header__breadcrumbs">
                <span>zuperming</span> / <span id="breadcrumb-current" class="active">Overview</span>
            </div>
        </div>

        <div class="zp-layout__content">
            
            <% if (message) { %>
                <div style="background:rgba(34,197,94,0.1); border:1px solid rgba(34,197,94,0.2); color:#4ade80; padding:12px 16px; border-radius:6px; margin-bottom:24px; font-size:13px;">
                    <%- message %>
                </div>
            <% } %>
            <% if (error) { %>
                <div style="background:rgba(239,68,68,0.1); border:1px solid rgba(239,68,68,0.2); color:#fca5a5; padding:12px 16px; border-radius:6px; margin-bottom:24px; font-size:13px;">
                    <%- error %>
                </div>
            <% } %>

            <!-- OVERVIEW TAB -->
            <div id="tab-overview" class="zp-tab-pane is-active">
                <h1 class="zp-page-title">System Overview</h1>
                <p class="zp-page-desc">High-level telemetry and usage statistics across all instances.</p>
                
                <div class="zp-grid-stats">
                    <div class="zp-stat-card">
                        <div class="zp-stat-card__label">Total Projects</div>
                        <div class="zp-stat-card__value"><%- totalGames %></div>
                    </div>
                    <div class="zp-stat-card">
                        <div class="zp-stat-card__label">Active Keys</div>
                        <div class="zp-stat-card__value"><%- totalKeys %></div>
                    </div>
                    <div class="zp-stat-card">
                        <div class="zp-stat-card__label">Users Tracked</div>
                        <div class="zp-stat-card__value"><%- totalUsers %></div>
                    </div>
                    <div class="zp-stat-card">
                        <div class="zp-stat-card__label">Total Executions</div>
                        <div class="zp-stat-card__value"><%- totalExecutions %></div>
                    </div>
                </div>

                <div class="zp-panel">
                    <div class="zp-panel__header">
                        <h2 class="zp-panel__title">Execution Telemetry (7 Days)</h2>
                    </div>
                    <div class="zp-panel__body" style="height: 300px;">
                        <canvas id="executionChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- PROJECTS TAB -->
            <div id="tab-projects" class="zp-tab-pane">
                <h1 class="zp-page-title">Project Directory</h1>
                <p class="zp-page-desc">Manage Lua environments and configurations for registered games.</p>
                
                <div class="zp-panel">
                    <div class="zp-panel__header">
                        <h2 class="zp-panel__title">Initialize New Project</h2>
                    </div>
                    <div class="zp-panel__body">
                        <form action="/admin/add-game" method="POST" style="display:flex; gap:16px; align-items:flex-end;">
                            <div class="zp-input-group" style="margin:0; flex:1;">
                                <label class="zp-input-label">Project Name</label>
                                <input type="text" name="name" class="zp-input" placeholder="e.g. Blox Fruits" required>
                            </div>
                            <div class="zp-input-group" style="margin:0; flex:1;">
                                <label class="zp-input-label">Roblox Place ID</label>
                                <input type="number" name="game_id" class="zp-input" placeholder="e.g. 2753915549" required>
                            </div>
                            <div class="zp-input-group" style="margin:0; flex:1;">
                                <label class="zp-input-label">Product Tier</label>
                                <select name="product" class="zp-input" required>
                                    <option value="" disabled selected>Select Tier...</option>
                                    <% Object.values(products).forEach(function(p) { %>
                                        <option value="<%- p.id %>"><%- p.name %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <button type="submit" class="zp-button">Deploy Project</button>
                        </form>
                    </div>
                </div>

                <% 
                    const projectTypes = [
                        { id: 'premium', label: 'Premium', typeClass: 'zp-badge--blue' },
                        { id: 'service_provider', label: 'Service Provider', typeClass: 'zp-badge--success' },
                        { id: 'freemium', label: 'Freemium', typeClass: 'zp-badge--neutral' },
                        { id: 'testing_dev', label: 'Testing Dev', typeClass: 'zp-badge--danger' }
                    ];
                %>
                
                <% projectTypes.forEach(function(ptype) { %>
                    <h3 style="margin-top: 2rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 8px; font-size:14px; color:var(--text-secondary);"><%- ptype.label %> Tier</h3>
                    <div class="zp-grid-stats" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); margin-top: 16px; margin-bottom: 16px;">
                        <% let typeGames = games.filter(g => g.product === ptype.id); %>
                        <% typeGames.forEach(function(g) { %>
                            <div class="zp-panel" style="margin-bottom:0;">
                                <div class="zp-panel__header">
                                    <div>
                                        <h2 class="zp-panel__title" style="display:inline-block; margin-right:8px;"><%- g.name %></h2>
                                        <% if (g.last_script_update) { %>
                                            <span id="upload-status-<%- g.roblox_game_id || g.roblox_game_id %>" class="zp-badge zp-badge--success">Uploaded</span>
                                        <% } else { %>
                                            <span id="upload-status-<%- g.roblox_game_id || g.roblox_game_id %>" class="zp-badge zp-badge--danger">Not Uploaded</span>
                                        <% } %>
                                    </div>
                                    <span class="zp-badge <%- ptype.typeClass %>"><%- ptype.label %></span>
                                </div>
                                <div class="zp-panel__body">
                                    <div class="zp-input-group">
                                        <label class="zp-input-label">Game ID</label>
                                        <div class="zp-mono"><%- g.roblox_game_id %></div>
                                    </div>
                                    <form onsubmit="handleUpload(event, '<%- g.roblox_game_id %>', '<%- g.product %>')" style="margin-top:16px; padding-top:16px; border-top:1px solid var(--border-subtle);">
                                        <input type="hidden" name="game_id" value="<%- g.roblox_game_id %>">
                                        <input type="hidden" name="product" value="<%- g.product %>">
                                        <div class="zp-input-group">
                                            <label class="zp-input-label">Upload Source (.lua)</label>
                                            <label class="zp-file-upload-btn">
                                                <span id="file-name-<%- g.roblox_game_id %>">Choose .lua File</span>
                                                <input type="file" name="script_file" accept=".lua,.txt" required style="display: none;" onchange="document.getElementById('file-name-<%- g.roblox_game_id %>').innerText = this.files[0].name">
                                            </label>
                                        </div>
                                        <div class="zp-input-group" style="display:flex; align-items:center; gap:8px;">
                                            <input type="checkbox" name="auto_obfuscate" id="obf_<%- g.product %>_<%- g.roblox_game_id %>" value="true" checked>
                                            <label for="obf_<%- g.product %>_<%- g.roblox_game_id %>" style="font-size:12px; color:var(--text-secondary); cursor:pointer;">Auto-Obfuscate (BETA)</label>
                                        </div>
                                        <button type="submit" class="zp-button zp-button--secondary" style="width:100%;">Upload Script</button>
                                    </form>
                                </div>
                            </div>
                        <% }); %>
                        <% if (typeGames.length === 0) { %>
                            <div style="color:var(--text-secondary); font-size:13px; font-style:italic;">No projects in this tier.</div>
                        <% } %>
                    </div>
                <% }); %>
            </div>

            <!-- KEYS TAB -->
            <div id="tab-keys" class="zp-tab-pane">
                <h1 class="zp-page-title">Access Keys</h1>
                <p class="zp-page-desc">Provision and monitor authentication tokens.</p>
                
                <div class="zp-panel" style="max-width:600px;">
                    <div class="zp-panel__header">
                        <h2 class="zp-panel__title">Provision Token</h2>
                    </div>
                    <div class="zp-panel__body">
                        <form action="/admin/generate-key" method="POST" style="display:flex; gap:16px; align-items:flex-end;">
                            <div class="zp-input-group" style="margin:0; flex:2;">
                                <label class="zp-input-label">Product Tier</label>
                                <select name="product" class="zp-input" required>
                                    <% Object.values(products).forEach(function(p) { %>
                                        <option value="<%- p.id %>"><%- p.name %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="zp-input-group" style="margin:0; flex:1.5;">
                                <label class="zp-input-label">Duration</label>
                                <input type="text" name="duration" class="zp-input" placeholder="1d, 30d, lifetime" required>
                            </div>
                            <button type="submit" class="zp-button">Generate</button>
                        </form>
                    </div>
                </div>

                <div class="zp-panel">
                    <div class="zp-table-wrapper">
                        <table class="zp-table">
                            <thead>
                                <tr>
                                    <th>Token / Key</th>
                                    <th>Tier</th>
                                    <th>Duration</th>
                                    <th>State</th>
                                    <th>Bound User (ID)</th>
                                    <th>Provisioned At</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% keys.forEach(function(k) { %>
                                    <tr>
                                        <td class="zp-mono"><%- k.key_string %></td>
                                        <td><span class="zp-badge zp-badge--neutral"><%- k.product %></span></td>
                                        <td><%- k.duration_label %></td>
                                        <td>
                                            <% if (k.status === 'used') { %>
                                                <span class="zp-badge zp-badge--danger">Used</span>
                                            <% } else { %>
                                                <span class="zp-badge zp-badge--success">Available</span>
                                            <% } %>
                                        </td>
                                        <td class="zp-mono"><%- k.discord_id ? k.discord_id : '-' %></td>
                                        <td style="color:var(--text-secondary)"><%- k.created_at %></td>
                                    </tr>
                                <% }); %>
                                <% if(keys.length === 0) { %>
                                    <tr><td colspan="6" style="text-align:center; color:var(--text-secondary)">No tokens provisioned.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- LOGS TAB -->
            <div id="tab-logs" class="zp-tab-pane">
                <h1 class="zp-page-title">Audit Logs</h1>
                <p class="zp-page-desc">System access records and authentication events.</p>
                
                <div class="zp-panel">
                    <div class="zp-table-wrapper">
                        <table class="zp-table">
                            <thead>
                                <tr>
                                    <th>Identity</th>
                                    <th>Discord ID</th>
                                    <th>Clearance Level</th>
                                    <th>Timestamp</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% loginLogs.forEach(function(l) { %>
                                    <tr>
                                        <td>
                                            <% if (l.avatar_url) { %>
                                                <img src="<%- l.avatar_url %>" class="zp-avatar" alt="">
                                            <% } else { %>
                                                <div class="zp-avatar"></div>
                                            <% } %>
                                            <strong><%- l.username %></strong>
                                        </td>
                                        <td class="zp-mono"><%- l.discord_id %></td>
                                        <td>
                                            <% let roleClass = (l.role === 'Developer' || l.role === 'Owner') ? 'zp-badge--blue' : 'zp-badge--neutral'; %>
                                            <span class="zp-badge <%- roleClass %>"><%- l.role %></span>
                                        </td>
                                        <td style="color:var(--text-secondary)"><%- l.login_time %></td>
                                    </tr>
                                <% }); %>
                                <% if(loginLogs.length === 0) { %>
                                    <tr><td colspan="4" style="text-align:center; color:var(--text-secondary)">No events recorded.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- BANNED IPS TAB -->
            <div id="tab-bans" class="zp-tab-pane">
                <h1 class="zp-page-title">IP Blacklist</h1>
                <p class="zp-page-desc">Manage blocked IP addresses that are denied access to scripts.</p>
                
                <div class="zp-panel" style="max-width:600px; margin-bottom: 2rem;">
                    <div class="zp-panel__header">
                        <h2 class="zp-panel__title">Ban New IP</h2>
                    </div>
                    <div class="zp-panel__body">
                        <form action="/admin/ban-ip" method="POST" style="display:flex; gap:16px; align-items:flex-end;">
                            <div class="zp-input-group" style="margin:0; flex:1;">
                                <label class="zp-input-label">IP Address</label>
                                <input type="text" name="ip" class="zp-input" placeholder="e.g. 192.168.1.1" required>
                            </div>
                            <div class="zp-input-group" style="margin:0; flex:2;">
                                <label class="zp-input-label">Reason</label>
                                <input type="text" name="reason" class="zp-input" placeholder="Bypassing / Exploit" required>
                            </div>
                            <button type="submit" class="zp-button zp-button--danger">Ban IP</button>
                        </form>
                    </div>
                </div>

                <div class="zp-panel">
                    <div class="zp-table-wrapper">
                        <table class="zp-table">
                            <thead>
                                <tr>
                                    <th>IP Address</th>
                                    <th>Reason</th>
                                    <th>Banned At</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% bannedIps.forEach(function(b) { %>
                                    <tr>
                                        <td class="zp-mono"><%- b.ip %></td>
                                        <td><%- b.reason %></td>
                                        <td style="color:var(--text-secondary)"><%- b.banned_at %></td>
                                        <td>
                                            <form action="/admin/unban-ip" method="POST" style="margin:0; display:inline-block;">
                                                <input type="hidden" name="ip" value="<%- b.ip %>">
                                                <button type="submit" class="zp-button" style="padding:4px 8px; font-size:11px;">Unban</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }); %>
                                <% if(bannedIps.length === 0) { %>
                                    <tr><td colspan="4" style="text-align:center; color:var(--text-secondary)">No IP addresses are currently banned.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- DEV ENVIRONMENT TAB -->
            <div id="tab-dev" class="zp-tab-pane">
                <h1 class="zp-page-title">Developer Environment</h1>
                <p class="zp-page-desc">Internal tooling for testing builds locally bypassing normal validation layers.</p>
                
                <div class="zp-panel" style="max-width:700px;">
                    <div class="zp-panel__header">
                        <h2 class="zp-panel__title">Testing Loader</h2>
                    </div>
                    <div class="zp-panel__body">
                        <div style="display:flex; gap:12px; margin-bottom: 16px;">
                            <button class="zp-button" onclick="getDevScript()">Fetch Dev Script</button>
                            <button class="zp-button zp-button--secondary" onclick="resetDevHwid()">Purge HWID Binding</button>
                        </div>
                        <div id="dev-response" class="zp-terminal" style="display:none;">
                            <span class="prompt">system@zuperming:~$</span> <span id="dev-output" class="code"></span>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>
    </div>

    <script>
        window.addEventListener('DOMContentLoaded', () => {
            const hash = window.location.hash.substring(1);
            if (hash && document.getElementById('tab-' + hash)) {
                const navItem = document.querySelector(`.zp-nav__item[onclick*="switchTab('${hash}'"]`);
                if(navItem) switchTab(hash, navItem);
            }
        });

        function switchTab(tabId, element) {
            window.location.hash = tabId;
            document.querySelectorAll('.zp-tab-pane').forEach(el => el.classList.remove('is-active'));
            document.querySelectorAll('.zp-nav__item').forEach(el => el.classList.remove('zp-nav__item--active'));
            
            document.getElementById('tab-' + tabId).classList.add('is-active');
            element.classList.add('zp-nav__item--active');
            document.getElementById('breadcrumb-current').textContent = element.textContent;
        }

        async function handleUpload(event, gameId, product) {
            event.preventDefault();
            const form = event.target;
            const btn = form.querySelector('button[type="submit"]');
            const originalText = btn.innerHTML;
            
            const formData = new FormData(form);
            
            btn.disabled = true;
            btn.innerHTML = '<span class="zp-spinner"></span> Uploading & Obfuscating...';
            
            try {
                const res = await fetch('/admin/upload-script', {
                    method: 'POST',
                    body: formData
                });
                
                if (res.redirected) {
                    window.location.href = res.url;
                    return;
                }
                
                const data = await res.json();
                if (data.success) {
                    btn.innerHTML = 'Success!';
                    btn.style.background = 'var(--accent-green)';
                    btn.style.color = 'var(--bg-base)';
                    btn.style.borderColor = 'var(--accent-green)';
                    
                    // Trigger download
                    const blob = new Blob([data.obfuscated], { type: 'text/plain' });
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `obfuscated_${gameId}.txt`;
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(url);
                    a.remove();
                    
                    setTimeout(() => {
                        btn.disabled = false;
                        btn.innerHTML = originalText;
                        btn.style.background = '';
                        btn.style.color = '';
                        btn.style.borderColor = '';
                        form.reset();
                        document.getElementById('file-name-' + gameId).innerText = 'Choose .lua File';
                        
                        // Update badge
                        const statusBadge = document.getElementById('upload-status-' + gameId);
                        if(statusBadge) {
                            statusBadge.className = 'zp-badge zp-badge--success';
                            statusBadge.innerText = 'Uploaded';
                        }
                    }, 3000);
                } else {
                    alert('Upload failed: ' + (data.error || 'Unknown error'));
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                }
            } catch (err) {
                alert('Request failed');
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        }

        async function getDevScript() {
            const respEl = document.getElementById('dev-response');
            const outEl = document.getElementById('dev-output');
            respEl.style.display = 'block';
            outEl.textContent = 'Requesting dev auth token...';
            try {
                const res = await fetch('/admin/dev-panel/script', { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    const code = `_G.Key = "${data.key}"\nloadstring(game:HttpGet("${data.baseUrl}/api/dev/execute?key=" .. _G.Key))()`;
                    outEl.textContent = code;
                } else {
                    outEl.textContent = "ERR: " + data.message;
                }
            } catch (err) {
                outEl.textContent = "ERR: Network request failed.";
            }
        }

        async function resetDevHwid() {
            const respEl = document.getElementById('dev-response');
            const outEl = document.getElementById('dev-output');
            respEl.style.display = 'block';
            outEl.textContent = 'Purging hardware lock...';
            try {
                const res = await fetch('/admin/dev-panel/reset-hwid', { method: 'POST' });
                const data = await res.json();
                outEl.textContent = data.message || "Operation completed.";
            } catch (err) {
                outEl.textContent = "ERR: Network request failed.";
            }
        }

        // Render dummy chart
        const ctx = document.getElementById('executionChart').getContext('2d');
        const gradient = ctx.createLinearGradient(0, 0, 0, 300);
        gradient.addColorStop(0, 'rgba(255, 255, 255, 0.15)');
        gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');
        
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Day 1', 'Day 2', 'Day 3', 'Day 4', 'Day 5', 'Day 6', 'Day 7'],
                datasets: [{
                    label: 'Executions',
                    data: [12, 19, 15, 25, 22, 30, 28],
                    borderColor: '#ffffff',
                    backgroundColor: gradient,
                    borderWidth: 2,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#000',
                    pointBorderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { color: '#222222' }, ticks: { color: '#a1a1aa' } },
                    y: { grid: { color: '#222222' }, ticks: { color: '#a1a1aa' } }
                }
            }
        });
    </script>
</body>
</html>
