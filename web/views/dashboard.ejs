<!-- ═══ MAIN ═══ -->
<main class="main">
    <div class="topbar">
        <div class="crumb">
            <span>MIE AYAM HUB</span>
            <span class="crumb-sep">/</span>
            <span id="crumb-active" class="crumb-active">overview</span>
        </div>
        <div class="topbar-right">
            <!-- BGM Toggle -->
            <button id="bgm-btn" class="btn btn-ghost" onclick="toggleBgm()" style="padding: 4px 10px; font-size: 11px; margin-right: 8px;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
                <span id="bgm-lbl">Play BGM</span>
            </button>
            <audio id="bgm-audio" loop autoplay src="https://files.catbox.moe/6xphq8.mp3"></audio>

            <div class="status-pill">
                <div class="status-dot"></div>
                ONLINE
            </div>
        </div>
    </div>

    <div class="content">

        <% if (message) { %>
        <div class="alert alert-ok">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <%- message %>
        </div>
        <% } %>
        <% if (error) { %>
        <div class="alert alert-err">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <%- error %>
        </div>
        <% } %>

        <!-- OVERVIEW -->
        <div id="tab-overview" class="tab-pane active">
            <div class="pg-head">
                <div class="pg-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                    System Overview
                </div>
                <div class="pg-sub">High-level telemetry across all active instances.</div>
            </div>

            <!-- Discord live stats bar -->
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;flex-wrap:wrap;">
                <div class="dc-stat">
                    <div class="dc-dot green"></div>
                    <span id="dc-online-count"><%- onlineMembers %></span>
                    <span style="color:var(--gray-500)">online</span>
                </div>
                <div class="dc-stat">
                    <div class="dc-dot gray"></div>
                    <span id="dc-total-count"><%- totalMembers %></span>
                    <span style="color:var(--gray-500)">total members</span>
                </div>
                <div style="margin-left:auto;font-family:var(--mono);font-size:10px;color:var(--gray-600);" id="dc-last-updated">updating...</div>
            </div>

            <div class="stats-grid">
                <div class="stat">
                    <div class="stat-icon">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg>
                    </div>
                    <div class="stat-label">Projects</div>
                    <div class="stat-val" id="stat-projects" data-target="<%- totalGames %>">0</div>
                </div>
                <div class="stat">
                    <div class="stat-icon">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
                    </div>
                    <div class="stat-label">Active Keys</div>
                    <div class="stat-val" id="stat-keys" data-target="<%- totalKeys %>">0</div>
                </div>
                <div class="stat">
                    <div class="stat-icon">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </div>
                    <div class="stat-label">Users</div>
                    <div class="stat-val" id="stat-users" data-target="<%- totalUsers %>">0</div>
                </div>
                <div class="stat">
                    <div class="stat-icon">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                    </div>
                    <div class="stat-label">Executions</div>
                    <div class="stat-val" id="stat-execs" data-target="<%- totalExecutions %>">0</div>
                </div>
            </div>

            <div class="panel">
                <div class="panel-hd">
                    <span class="panel-title"><span class="panel-dot"></span> Execution Telemetry (7d)</span>
                    <span class="badge badge-white">LIVE</span>
                </div>
                <div class="panel-bd">
                    <div class="chart-wrap"><canvas id="exec-chart"></canvas></div>
                </div>
            </div>
        </div>

        <!-- SEARCH AI -->
        <div id="tab-search-ai" class="tab-pane">
            <div class="pg-head">
                <div class="pg-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    Search AI
                </div>
                <div class="pg-sub">Natural language search for Roblox Place ID and Game ID.</div>
            </div>

            <div class="panel">
                <div class="panel-hd"><span class="panel-title"><span class="panel-dot"></span> Ask AI</span></div>
                <div class="panel-bd">
                    <div class="form-row">
                        <div class="field">
                            <input type="text" id="ai-search-inp" class="inp" placeholder="e.g. carikan game id atau place id nya fisch" autocomplete="off" onkeypress="if(event.key === 'Enter') performAiSearch()">
                        </div>
                        <button type="button" class="btn btn-white" onclick="performAiSearch()" id="btn-ai-search">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                            Search
                        </button>
                    </div>
                    <div id="ai-search-result" class="terminal" style="margin-top: 14px; display: none;"></div>
                </div>
            </div>
        </div>

        <!-- ANALYTICS -->
        <div id="tab-analytics" class="tab-pane">
            <div class="pg-head">
                <div class="pg-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"/></svg>
                    Analytics
                </div>
                <div class="pg-sub">Geographic breakdown of script executions by country and region.</div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;">
                <div class="panel">
                    <div class="panel-hd">
                        <span class="panel-title"><span class="panel-dot"></span> Top Countries</span>
                        <span id="geo-total-badge" class="badge badge-white">loading...</span>
                    </div>
                    <div class="panel-bd">
                        <div id="geo-countries" class="geo-bar">
                            <div style="color:var(--gray-600);font-size:12px;text-align:center;padding:20px;">Loading geo data...</div>
                        </div>
                    </div>
                </div>
                <div class="panel">
                    <div class="panel-hd"><span class="panel-title"><span class="panel-dot"></span> Top Regions</span></div>
                    <div class="panel-bd">
                        <div id="geo-regions" class="geo-bar">
                            <div style="color:var(--gray-600);font-size:12px;text-align:center;padding:20px;">Loading...</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="panel">
                <div class="panel-hd"><span class="panel-title"><span class="panel-dot"></span> Execution Log</span></div>
                <div class="panel-bd" style="text-align:center;color:var(--gray-600);font-size:12.5px;padding:12px 0;">
                    Geographic data is collected on every script execution. Data populates as users run scripts.
                </div>
            </div>
        </div>

        <!-- PROJECTS v2 -->
        <div id="tab-projects" class="tab-pane">
            <div class="pg-head" style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:12px;">
                <div>
                    <div class="pg-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg>
                        Projects
                    </div>
                    <div class="pg-sub">Manage script projects &amp; files. Click a project to open its detail panel.</div>
                </div>
                <button class="btn btn-white" onclick="document.getElementById('modal-create-proj').classList.add('show')">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    New Project
                </button>
            </div>



            <!-- Projects v2 section -->
            <div class="sec-head" style="margin-top:24px;">
                <span class="sec-lbl">Your Projects</span>
                <div class="sec-line"></div>
                <span class="badge badge-white"><%- projectsV2.length %></span>
            </div>

            <% if (projectsV2.length === 0) { %>
            <div style="background:var(--gray-950);border:1px dashed var(--gray-700);border-radius:12px;padding:40px;text-align:center;color:var(--gray-600);">
                <div style="font-size:28px;margin-bottom:10px;">📁</div>
                <div style="font-weight:600;color:var(--gray-400);margin-bottom:6px;">No projects yet</div>
                <div style="font-size:12.5px;">Click <strong style="color:var(--white);">New Project</strong> to create your first project.</div>
            </div>
            <% } else { %>
            <div class="pv2-grid">
                <% projectsV2.forEach(function(p) { %>
                <div class="pv2-card" onclick="openProjectDrawer(<%- p.id %>, '<%- (p.display_name || p.name).replace(/'/g, `\\'`) %>', '<%- p.uuid %>', '<%- (p.logo_url || '').replace(/'/g, `\\'`) %>')">
                    <div class="pv2-card-top">
                        <div class="pv2-logo">
                            <% if (p.logo_url) { %>
                                <img src="<%- p.logo_url %>" alt="">
                            <% } else { %>
                                📦
                            <% } %>
                        </div>
                        <div style="flex:1;min-width:0;">
                            <div class="pv2-name" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%- p.display_name || p.name %></div>
                            <div class="pv2-uuid"><%- p.uuid %></div>
                        </div>
                    </div>
                    <div class="pv2-card-bot">
                        <div class="pv2-meta">
                            <span>📄 <%- p.file_count %> file<%- p.file_count !== 1 ? 's' : '' %></span>
                            <span style="color:var(--gray-600);"><%- p.is_free ? 'Free' : 'Premium' %></span>
                        </div>
                        <button type="button" class="btn btn-red" style="padding:4px 9px;font-size:11px;" onclick="event.stopPropagation(); deleteProject(<%- p.id %>, '<%- Buffer.from(p.display_name || p.name).toString('base64') %>')">
                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/></svg>
                        </button>
                    </div>
                </div>
                <% }); %>
            </div>
            <% } %>
        </div>

        <!-- KEYS -->
        <div id="tab-keys" class="tab-pane">
            <div class="pg-head">
                <div class="pg-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
                    Access Keys
                </div>
                <div class="pg-sub">Provision and monitor authentication tokens.</div>
            </div>

            <div class="panel" style="max-width:600px;">
                <div class="panel-hd"><span class="panel-title"><span class="panel-dot"></span> Provision Token</span></div>
                <div class="panel-bd">
                    <form action="/admin/generate-key" method="POST">
                        <div class="form-row">
                            <div class="field" style="flex:2;">
                                <label class="lbl">Product Tier</label>
                                <select name="product" class="sel" required>
                                    <% Object.values(products).forEach(function(p) { %>
                                        <option value="<%- p.id %>"><%- p.name %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="field" style="flex:1.5;">
                                <label class="lbl">Duration</label>
                                <input type="text" name="duration" class="inp" placeholder="1d / 30d / lifetime" required>
                            </div>
                            <button type="submit" class="btn btn-white">Generate</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="panel">
                <div class="panel-hd">
                    <span class="panel-title"><span class="panel-dot"></span> All Tokens</span>
                    <span class="badge badge-white"><%- keys.length %></span>
                </div>
                <div class="tbl-wrap">
                    <table class="tbl">
                        <thead><tr><th>Token</th><th>Tier</th><th>Duration</th><th>State</th><th>Bound User</th><th>Issued At</th></tr></thead>
                        <tbody>
                            <% keys.forEach(function(k) { %>
                            <tr>
                                <td class="mono"><%- k.key_string %></td>
                                <td><span class="badge badge-white"><%- k.product %></span></td>
                                <td style="color:var(--gray-400)"><%- k.duration_label %></td>
                                <td>
                                    <% if (k.status === 'used') { %>
                                        <span class="badge badge-on">Active</span>
                                    <% } else { %>
                                        <span class="badge badge-off">Unused</span>
                                    <% } %>
                                </td>
                                <td class="mono"><%- k.discord_id ? k.discord_id : '—' %></td>
                                <td style="color:var(--gray-500)"><%- k.created_at %></td>
                            </tr>
                            <% }); %>
                            <% if(keys.length === 0) { %>
                            <tr><td colspan="6" style="text-align:center;color:var(--gray-600);padding:28px;">No tokens provisioned.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- LOGS -->
        <div id="tab-logs" class="tab-pane">
            <div class="pg-head">
                <div class="pg-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                    Audit Logs
                </div>
                <div class="pg-sub">System access records and authentication events.</div>
            </div>

            <div class="panel">
                <div class="panel-hd">
                    <span class="panel-title"><span class="panel-dot"></span> Login Events</span>
                    <span class="badge badge-white"><%- loginLogs.length %></span>
                </div>
                <div class="tbl-wrap">
                    <table class="tbl">
                        <thead><tr><th>Identity</th><th>Discord ID</th><th>Clearance</th><th>Timestamp</th></tr></thead>
                        <tbody>
                            <% loginLogs.forEach(function(l) { %>
                            <tr>
                                <td>
                                    <div style="display:flex;align-items:center;gap:8px;">
                                        <% if (l.avatar_url) { %>
                                            <img src="<%- l.avatar_url %>" style="width:24px;height:24px;border-radius:5px;object-fit:cover;" alt="">
                                        <% } else { %>
                                            <div style="width:24px;height:24px;border-radius:5px;background:var(--gray-800);"></div>
                                        <% } %>
                                        <span style="font-weight:600;"><%- l.username %></span>
                                    </div>
                                </td>
                                <td class="mono"><%- l.discord_id %></td>
                                <td>
                                    <% const isAdmin = (l.role === 'Developer' || l.role === 'Owner'); %>
                                    <span class="badge <%- isAdmin ? 'badge-on' : 'badge-white' %>"><%- l.role %></span>
                                </td>
                                <td style="color:var(--gray-500)"><%- l.login_time %></td>
                            </tr>
                            <% }); %>
                            <% if(loginLogs.length === 0) { %>
                            <tr><td colspan="4" style="text-align:center;color:var(--gray-600);padding:28px;">No events recorded.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- BANS -->
        <div id="tab-bans" class="tab-pane">
            <div class="pg-head">
                <div class="pg-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                    IP Blacklist
                </div>
                <div class="pg-sub">Blocked IPs are denied script access and key validation.</div>
            </div>

            <div class="panel" style="max-width:620px;margin-bottom:16px;">
                <div class="panel-hd"><span class="panel-title"><span class="panel-dot"></span> Blacklist IP</span></div>
                <div class="panel-bd">
                    <form action="/admin/ban-ip" method="POST">
                        <div class="form-row">
                            <div class="field">
                                <label class="lbl">IP Address</label>
                                <input type="text" name="ip" class="inp" placeholder="e.g. 192.168.1.1" required>
                            </div>
                            <div class="field" style="flex:2;">
                                <label class="lbl">Reason</label>
                                <input type="text" name="reason" class="inp" placeholder="e.g. HWID bypass attempt" required>
                            </div>
                            <button type="submit" class="btn btn-ghost">Ban IP</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="panel">
                <div class="panel-hd">
                    <span class="panel-title"><span class="panel-dot"></span> Banned IPs</span>
                    <span class="badge badge-white"><%- bannedIps.length %> blocked</span>
                </div>
                <div class="tbl-wrap">
                    <table class="tbl">
                        <thead><tr><th>IP Address</th><th>Reason</th><th>Banned At</th><th>Action</th></tr></thead>
                        <tbody>
                            <% bannedIps.forEach(function(b) { %>
                            <tr>
                                <td class="mono"><%- b.ip %></td>
                                <td style="color:var(--gray-400)"><%- b.reason %></td>
                                <td style="color:var(--gray-500)"><%- b.banned_at %></td>
                                <td>
                                    <form action="/admin/unban-ip" method="POST" style="margin:0;">
                                        <input type="hidden" name="ip" value="<%- b.ip %>">
                                        <button type="submit" class="btn btn-ghost" style="padding:5px 12px;font-size:11.5px;">Unban</button>
                                    </form>
                                </td>
                            </tr>
                            <% }); %>
                            <% if(bannedIps.length === 0) { %>
                            <tr><td colspan="4" style="text-align:center;color:var(--gray-600);padding:28px;">No IPs blacklisted.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- DEV -->
        <div id="tab-dev" class="tab-pane">
            <div class="pg-head">
                <div class="pg-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                    Dev Console
                </div>
                <div class="pg-sub">Internal tooling for testing builds, bypassing normal validation.</div>
            </div>

            <div class="panel" style="max-width:700px;">
                <div class="panel-hd">
                    <span class="panel-title"><span class="panel-dot"></span> Testing Loader</span>
                    <span class="badge badge-warn">DEV MODE</span>
                </div>
                <div class="panel-bd">
                    <div style="display:flex;gap:8px;flex-wrap:wrap;">
                        <button class="btn btn-white" onclick="getDevScript()">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                            Fetch Dev Script
                        </button>
                        <button class="btn btn-ghost" onclick="resetDevHwid()">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.98"/></svg>
                            Purge HWID
                        </button>
                    </div>
                    <div id="dev-term" class="terminal">
                        <span id="dev-out"></span>
                    </div>
                </div>
            </div>
        </div>

    </div>
</main>

<!-- ═══ PROJECT CREATE MODAL ═══ -->
<div id="modal-create-proj" class="modal-backdrop" onclick="if(event.target===this)this.classList.remove('show')">
    <div class="modal">
        <div class="modal-title">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg>
            New Project
            <button class="modal-close" onclick="document.getElementById('modal-create-proj').classList.remove('show')">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <form action="/admin/project/create" method="POST" enctype="multipart/form-data">
            <div class="field" style="margin-bottom:12px;">
                <label class="lbl">Project Name *</label>
                <input type="text" name="name" class="inp" placeholder="e.g. Fisch Premium" required>
            </div>
            <div class="field" style="margin-bottom:12px;">
                <label class="lbl">Description</label>
                <input type="text" name="description" class="inp" placeholder="Short description of this project">
            </div>
            <div class="field" style="margin-bottom:12px;">
                <label class="lbl">Plan Type</label>
                <select name="is_free" class="sel" style="width:100%; padding:8px; background:var(--gray-800); color:var(--white); border:1px solid var(--border); border-radius:4px;">
                    <option value="0">Premium</option>
                    <option value="1">Freemium</option>
                </select>
            </div>
            <div class="field" style="margin-bottom:12px;">
                <label class="lbl">Logo / Icon</label>
                <label class="file-area" for="modal-logo-file" style="margin-bottom:0;">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                    <span id="modal-logo-name">Upload logo image (PNG/JPG)</span>
                    <input type="file" id="modal-logo-file" name="logo_file" accept="image/*" style="display:none;" onchange="document.getElementById('modal-logo-name').textContent=this.files[0]?.name||'Choose image'">
                </label>
                <div style="margin-top:8px;">
                    <label class="lbl">Or Logo URL</label>
                    <input type="text" name="logo_url" class="inp" placeholder="https://... (optional)">
                </div>
            </div>
            <div style="display:flex;gap:8px;margin-top:6px;">
                <button type="submit" class="btn btn-white" style="flex:1;">Create Project</button>
                <button type="button" class="btn btn-ghost" onclick="document.getElementById('modal-create-proj').classList.remove('show')">Cancel</button>
            </div>
        </form>
    </div>
</div>

<!-- ═══ PROJECT DRAWER ═══ -->
<div id="drawer-backdrop" class="drawer-backdrop" onclick="closeDrawer()"></div>
<aside id="project-drawer" class="drawer">
    <div class="drawer-header">
        <div class="drawer-logo" id="drawer-logo">📦</div>
        <div>
            <div class="drawer-title" id="drawer-name">Project</div>
            <div class="drawer-uuid" id="drawer-uuid"></div>
        </div>
        <button class="modal-close" style="margin-left:auto;" onclick="closeDrawer()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
    </div>

    <!-- Loader URL -->
    <div class="panel" style="margin-bottom:14px;">
        <div class="panel-hd"><span class="panel-title"><span class="panel-dot"></span> Loader URL</span></div>
        <div class="panel-bd" style="display:flex;gap:8px;align-items:center;">
            <code id="drawer-loader-url" style="font-family:var(--mono);font-size:11px;color:var(--gray-400);flex:1;word-break:break-all;"></code>
            <button class="btn btn-ghost" style="padding:5px 10px;font-size:11px;flex-shrink:0;" onclick="copyLoaderUrl()">Copy</button>
        </div>
    </div>

    <!-- Upload file -->
    <div class="panel" style="margin-bottom:14px;">
        <div class="panel-hd"><span class="panel-title"><span class="panel-dot"></span> Add File</span></div>
        <div class="panel-bd">
            <div id="file-upload-form">
                <div class="field" style="margin-bottom:10px;">
                    <label class="lbl">File Display Name *</label>
                    <input type="text" id="new-file-name" class="inp" placeholder="e.g. Main Script v2.1">
                </div>
                <label class="file-area" for="new-file-input" style="margin-bottom:10px;">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                    <span id="new-file-label">Choose .lua or .txt file</span>
                    <input type="file" id="new-file-input" accept=".lua,.txt" style="display:none;" onchange="document.getElementById('new-file-label').textContent=this.files[0]?.name||'Choose file'">
                </label>
                <button class="btn btn-white" style="width:100%;" onclick="uploadFileToProject()">Upload File</button>
            </div>
        </div>
    </div>

    <!-- File list -->
    <div class="sec-head" style="margin-top:0;"><span class="sec-lbl">Files</span><div class="sec-line"></div><span id="drawer-file-count" class="badge badge-white">0</span></div>
    <div id="drawer-file-list"></div>
</aside>

<script>
    let _activeProjectId = null;
    let _activeProjectUuid = null;
    const BASE_URL = '<%- baseUrl %>';

    /* ─── TABS ─── */
    window.addEventListener('DOMContentLoaded', () => {
        // Animated stat counters
        animateCounters();
        // Refresh Discord stats every 30s
        refreshDiscordStats();
        setInterval(refreshDiscordStats, 30000);

        const hash = window.location.hash.slice(1);
        if (hash && document.getElementById('tab-' + hash)) {
            const el = document.querySelector(`.nav-item[onclick*="'${hash}'"]`);
            if (el) switchTab(hash, el);
        }
    });

    function animateCounters() {
        document.querySelectorAll('.stat-val[data-target]').forEach(el => {
            const target = parseInt(el.dataset.target, 10) || 0;
            if (target === 0) { el.textContent = '0'; return; }
            let current = 0;
            const step = Math.max(1, Math.ceil(target / 40));
            const timer = setInterval(() => {
                current = Math.min(current + step, target);
                el.textContent = current.toLocaleString();
                if (current >= target) clearInterval(timer);
            }, 20);
        });
    }

    async function refreshDiscordStats() {
        try {
            const r = await fetch('/admin/api/discord-stats');
            const d = await r.json();
            document.getElementById('dc-online-count').textContent = d.online;
            document.getElementById('dc-total-count').textContent = d.total;
            const now = new Date();
            document.getElementById('dc-last-updated').textContent = 'updated ' + now.getHours().toString().padStart(2,'0') + ':' + now.getMinutes().toString().padStart(2,'0');
        } catch(_) {}
    }

    function switchTab(id, el) {
        window.location.hash = id;
        document.querySelectorAll('.tab-pane').forEach(e => e.classList.remove('active'));
        document.querySelectorAll('.nav-item').forEach(e => e.classList.remove('active'));
        document.getElementById('tab-' + id).classList.add('active');
        el.classList.add('active');
        document.getElementById('crumb-active').textContent = id;
        if (id === 'analytics') loadGeoStats();
    }

    /* ─── GEO ANALYTICS ─── */
    const countryFlags = { 'ID':'🇮🇩','US':'🇺🇸','SG':'🇸🇬','MY':'🇲🇾','PH':'🇵🇭','TH':'🇹🇭','AU':'🇦🇺','GB':'🇬🇧','DE':'🇩🇪','NL':'🇳🇱','CA':'🇨🇦','BR':'🇧🇷','JP':'🇯🇵','KR':'🇰🇷','VN':'🇻🇳','FR':'🇫🇷','IT':'🇮🇹','RU':'🇷🇺','TR':'🇹🇷','SA':'🇸🇦' };
    async function loadGeoStats() {
        try {
            const r = await fetch('/api/geo-stats');
            const d = await r.json();
            document.getElementById('geo-total-badge').textContent = d.total.toLocaleString() + ' execs';

            const countriesEl = document.getElementById('geo-countries');
            const regionsEl = document.getElementById('geo-regions');

            if (!d.countries.length) {
                countriesEl.innerHTML = '<div style="color:var(--gray-600);font-size:12px;text-align:center;padding:20px;">No data yet — execute scripts to see geo stats.</div>';
                regionsEl.innerHTML = countriesEl.innerHTML;
                return;
            }

            const maxC = d.countries[0]?.count || 1;
            countriesEl.innerHTML = d.countries.map(c => `
                <div class="geo-row">
                    <div class="geo-flag">${countryFlags[c.country_code] || '🌐'}</div>
                    <div class="geo-country">${c.country}</div>
                    <div class="geo-progress"><div class="geo-fill" style="width:${Math.round(c.count/maxC*100)}%"></div></div>
                    <div class="geo-count">${c.count}</div>
                </div>`).join('');

            const maxR = d.regions[0]?.count || 1;
            regionsEl.innerHTML = d.regions.map(r => `
                <div class="geo-row">
                    <div class="geo-flag">${countryFlags[r.country?.slice(0,2)?.toUpperCase()] || '📍'}</div>
                    <div class="geo-country">${r.region || '—'}<span style="color:var(--gray-600);font-size:10px;"> · ${r.country || ''}</span></div>
                    <div class="geo-progress"><div class="geo-fill" style="width:${Math.round(r.count/maxR*100)}%"></div></div>
                    <div class="geo-count">${r.count}</div>
                </div>`).join('');
        } catch(e) {
            document.getElementById('geo-countries').innerHTML = '<div style="color:var(--gray-600);font-size:12px;text-align:center;padding:20px;">Failed to load geo data.</div>';
        }
    }

    /* ─── PROJECT DRAWER ─── */
    function openProjectDrawer(id, name, uuid, logoUrl) {
        _activeProjectId = id;
        _activeProjectUuid = uuid;
        document.getElementById('drawer-name').textContent = name;
        document.getElementById('drawer-uuid').textContent = uuid;
        const loaderUrl = BASE_URL + '/scripts/v4/loaders/' + uuid + '.lua';
        document.getElementById('drawer-loader-url').textContent = loaderUrl;

        const logoEl = document.getElementById('drawer-logo');
        if (logoUrl) {
            logoEl.innerHTML = '<img src="' + logoUrl + '" alt="">';
        } else {
            logoEl.innerHTML = '📦';
        }

        document.getElementById('drawer-backdrop').classList.add('show');
        document.getElementById('project-drawer').classList.add('open');
        loadProjectFiles();
    }

    function closeDrawer() {
        document.getElementById('drawer-backdrop').classList.remove('show');
        document.getElementById('project-drawer').classList.remove('open');
        _activeProjectId = null;
    }

    function copyLoaderUrl() {
        const url = document.getElementById('drawer-loader-url').textContent;
        navigator.clipboard.writeText(url).then(() => toast('Loader URL copied!'));
    }

    async function loadProjectFiles() {
        if (!_activeProjectId) return;
        const el = document.getElementById('drawer-file-list');
        el.innerHTML = '<div style="color:var(--gray-600);font-size:12px;padding:12px;">Loading...</div>';
        try {
            const r = await fetch('/admin/project/' + _activeProjectId + '/files');
            const d = await r.json();
            const files = d.files || [];
            document.getElementById('drawer-file-count').textContent = files.length;

            if (!files.length) {
                el.innerHTML = '<div style="color:var(--gray-600);font-size:12.5px;padding:8px 2px;font-style:italic;">No files yet. Upload one above.</div>';
                return;
            }

            el.innerHTML = files.map(f => {
                const createdAgo = timeAgo(f.created_at);
                const updatedAgo = timeAgo(f.updated_at);
                return `<div class="file-item" id="file-item-${f.id}">
                    <div class="file-icon">
                        ${f.logo_url ? '<img src="'+f.logo_url+'" alt="">' : (f.file_type === 'lua' ? '🗂️' : '📄')}
                    </div>
                    <div style="flex:1;min-width:0;">
                        <div class="file-name" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${f.display_name}</div>
                        <div class="file-meta">Created ${createdAgo} &bull; Updated ${updatedAgo} &bull; .${f.file_type}</div>
                    </div>
                    <div class="file-actions">
                        <button class="btn btn-red" onclick="deleteProjectFile(${f.id})" title="Delete file">
                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/></svg>
                        </button>
                    </div>
                </div>`;
            }).join('');
        } catch(e) {
            el.innerHTML = '<div style="color:var(--gray-500);font-size:12px;">Error loading files.</div>';
        }
    }

    async function uploadFileToProject() {
        if (!_activeProjectId) return;
        const nameInput = document.getElementById('new-file-name');
        const fileInput = document.getElementById('new-file-input');
        if (!nameInput.value.trim()) { toast('Please enter a file display name.', false); return; }
        if (!fileInput.files[0]) { toast('Please choose a file.', false); return; }

        const fd = new FormData();
        fd.append('display_name', nameInput.value.trim());
        fd.append('script_file', fileInput.files[0]);

        const btn = event.currentTarget || document.querySelector('#file-upload-form .btn-white');
        const orig = btn.textContent;
        btn.disabled = true; btn.textContent = 'Uploading...';

        try {
            const r = await fetch('/admin/project/' + _activeProjectId + '/add-file', { method: 'POST', body: fd });
            const d = await r.json();
            if (d.success) {
                toast('File uploaded!');
                nameInput.value = '';
                fileInput.value = '';
                document.getElementById('new-file-label').textContent = 'Choose .lua or .txt file';
                loadProjectFiles();
            } else {
                toast('Upload failed: ' + (d.message || 'error'), false);
            }
        } catch(e) {
            toast('Network error.', false);
        } finally {
            btn.disabled = false; btn.textContent = orig;
        }
    }

    async function deleteProjectFile(fileId) {
        if (!confirm('Delete this file? This cannot be undone.')) return;
        const r = await fetch('/admin/project/' + _activeProjectId + '/file/' + fileId + '/delete', { method: 'POST' });
        const d = await r.json();
        if (d.success) { toast('File deleted.'); loadProjectFiles(); }
        else toast('Delete failed.', false);
    }

    async function deleteProject(id, b64name) {
        let name = '';
        try { name = atob(b64name); } catch(e) { name = 'Project'; }
        if (!confirm('Delete project "' + name + '" and all its files? This CANNOT be undone.')) return;
        const r = await fetch('/admin/project/' + id + '/delete', { method: 'POST' });
        const d = await r.json();
        if (d.success) { toast('Project deleted.'); setTimeout(() => window.location.reload(), 800); }
        else toast('Delete failed.', false);
    }

    function timeAgo(dateStr) {
        if (!dateStr) return '—';
        const diff = (Date.now() - new Date(dateStr).getTime()) / 1000;
        if (diff < 60) return Math.round(diff) + 's ago';
        if (diff < 3600) return Math.round(diff/60) + 'm ago';
        if (diff < 86400) return Math.round(diff/3600) + 'h ago';
        return Math.round(diff/86400) + 'd ago';
    }

    /* ─── TOAST ─── */
    function toast(msg, ok = true) {
        const t = document.getElementById('toast');
        const d = document.getElementById('toast-dot');
        const m = document.getElementById('toast-msg');
        d.style.background = ok ? '#f5f5f5' : '#666';
        m.textContent = msg;
        t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 3500);
    }


    /* ─── DEV CONSOLE ─── */
    async function getDevScript() {
        const term = document.getElementById('dev-term');
        const out = document.getElementById('dev-out');
        term.classList.add('show');
        out.innerHTML = `<span class="p">$</span> Requesting dev auth token...`;
        try {
            const r = await fetch('/admin/dev-panel/script', { method: 'POST' });
            const d = await r.json();
            if (d.success) {
                out.innerHTML = `<span class="p">$</span> <span class="ok">AUTH OK</span>\n\n_G.Key = "${d.key}"\nloadstring(game:HttpGet("${d.baseUrl}/api/dev/execute?key=" .. _G.Key))()`;
            } else {
                out.innerHTML = `<span class="p">$</span> <span class="er">ERR: ${d.message}</span>`;
            }
        } catch {
            out.innerHTML = `<span class="p">$</span> <span class="er">ERR: Network request failed</span>`;
        }
    }

    async function resetDevHwid() {
        const term = document.getElementById('dev-term');
        const out = document.getElementById('dev-out');
        term.classList.add('show');
        out.innerHTML = `<span class="p">$</span> Purging HWID binding...`;
        try {
            const r = await fetch('/admin/dev-panel/reset-hwid', { method: 'POST' });
            const d = await r.json();
            out.innerHTML = `<span class="p">$</span> <span class="ok">${d.message || 'HWID cleared.'}</span>`;
        } catch {
            out.innerHTML = `<span class="p">$</span> <span class="er">ERR: Network request failed</span>`;
        }
    }

    /* ─── AI SEARCH ─── */
    
    async function fetchRobloxInfo(placeId) {
        placeId = String(placeId || '').trim();
        if (!placeId) return;
        const nameInp = document.getElementById('proj-name');
        try {
            const res = await fetch('/admin/roblox-game-info?place_id=' + encodeURIComponent(placeId));
            const data = await res.json();
            if (data.success && data.name && (!nameInp.value || nameInp.value.trim() === '')) {
                nameInp.value = data.name;
            }
        } catch(e) {}
    }

    async function performAiSearch() {
        const inp = document.getElementById('ai-search-inp');
        const btn = document.getElementById('btn-ai-search');
        const resultDiv = document.getElementById('ai-search-result');
        const query = inp.value.trim();

        if (!query) return;

        // Reset
        btn.disabled = true;
        btn.innerHTML = '<span class="spin spin-white"></span> Searching...';
        resultDiv.style.display = 'none';

        try {
            const res = await fetch('/admin/ai-search?q=' + encodeURIComponent(query));
            const data = await res.json();
            
            resultDiv.innerHTML = data.result ? data.result : 'No response from AI.';
            resultDiv.style.display = 'block';
        } catch (e) {
            resultDiv.innerHTML = '<span class="er">Error contacting AI server.</span>';
            resultDiv.style.display = 'block';
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg> Search';
        }
    }

    /* ─── AUDIO ─── */
    function toggleBgm() {
        const audio = document.getElementById('bgm-audio');
        if (audio.paused) {
            audio.play();
        } else {
            audio.pause();
        }
    }

    document.getElementById('bgm-audio').addEventListener('play', () => {
        document.getElementById('bgm-lbl').textContent = 'Pause BGM';
    });
    
    document.getElementById('bgm-audio').addEventListener('pause', () => {
        document.getElementById('bgm-lbl').textContent = 'Play BGM';
    });

    /* ─── CHART ─── */
    const ctx = document.getElementById('exec-chart').getContext('2d');
    const grd = ctx.createLinearGradient(0, 0, 0, 200);
    grd.addColorStop(0, 'rgba(255,255,255,0.12)');
    grd.addColorStop(1, 'rgba(255,255,255,0)');

    new Chart(ctx, {
        type: 'line',
        data: {
            labels: ['Day 1','Day 2','Day 3','Day 4','Day 5','Day 6','Day 7'],
            datasets: [{
                label: 'Executions',
                data: [12, 19, 15, 25, 22, 30, 28],
                borderColor: '#f5f5f5',
                backgroundColor: grd,
                borderWidth: 1.5,
                fill: true,
                tension: 0.45,
                pointBackgroundColor: '#000',
                pointBorderColor: '#f5f5f5',
                pointBorderWidth: 1.5,
                pointRadius: 3,
                pointHoverRadius: 5
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { intersect: false, mode: 'index' },
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#0d0d0d',
                    borderColor: 'rgba(255,255,255,0.1)',
                    borderWidth: 1,
                    padding: 10,
                    titleColor: '#f5f5f5',
                    bodyColor: '#666'
                }
            },
            scales: {
                x: {
                    grid: { color: 'rgba(255,255,255,0.04)', borderDash: [3,3] },
                    ticks: { color: '#555', font: { size: 10 } },
                    border: { display: false }
                },
                y: {
                    grid: { color: 'rgba(255,255,255,0.04)', borderDash: [3,3] },
                    ticks: { color: '#555', font: { size: 10 } },
                    border: { display: false }
                }
            }
        }
    });
</script>
</body>
