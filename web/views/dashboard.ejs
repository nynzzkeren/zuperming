<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zuperming Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Orbitron:wght@500;700&family=Space+Grotesk:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --panel: rgba(8, 12, 28, 0.78);
            --border: rgba(59, 130, 246, 0.22);
            --text: #e8eefc;
            --muted: #8b9bc4;
            --blue: #3b82f6;
            --blue-bright: #60a5fa;
            --magenta: #e11d8f;
            --danger: #f87171;
            --bg-image: url('https://cdn.discordapp.com/attachments/1482305764315107423/1532727199881363637/1783999829490.png?ex=6a6de6f1&is=6a6c9571&hm=0f7b740f2385acefcefdd24820f12617d61f6bd4158355a494e856172da7bbd5');
        }
        * { box-sizing: border-box; }
        body {
            font-family: 'Space Grotesk', sans-serif;
            background:
                linear-gradient(145deg, rgba(5,7,15,0.92), rgba(10,20,55,0.88), rgba(18,8,30,0.9)),
                var(--bg-image) center / cover no-repeat fixed;
            color: var(--text);
            margin: 0;
            min-height: 100vh;
        }
        .sidebar {
            width: 250px;
            height: 100vh;
            background: rgba(6, 10, 24, 0.92);
            backdrop-filter: blur(12px);
            position: fixed;
            border-right: 1px solid var(--border);
            padding-top: 30px;
            z-index: 20;
        }
        .sidebar h2 {
            text-align: center;
            font-family: 'Orbitron', sans-serif;
            background: linear-gradient(90deg, var(--blue-bright), #a78bfa, var(--magenta));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 40px;
        }
        .sidebar a {
            display: block;
            padding: 15px 25px;
            color: var(--muted);
            text-decoration: none;
            font-weight: 600;
        }
        .sidebar a:hover, .sidebar a.active {
            background: linear-gradient(90deg, rgba(59,130,246,0.18), rgba(225,29,143,0.08));
            color: var(--blue-bright);
            border-left: 3px solid var(--blue);
        }
        .sidebar a.logout { color: var(--danger); position: absolute; bottom: 20px; width: 100%; border: none; }
        .menu-toggle {
            display: none;
            position: fixed;
            top: 14px; left: 14px;
            z-index: 30;
            background: rgba(6,10,24,0.95);
            border: 1px solid var(--border);
            color: var(--text);
            border-radius: 10px;
            padding: 10px 14px;
            font-weight: 700;
        }
        .content { margin-left: 250px; padding: 40px; }
        .stats-container { display: flex; gap: 20px; margin-bottom: 30px; flex-wrap: wrap; }
        .stat-card {
            background: var(--panel);
            backdrop-filter: blur(10px);
            padding: 24px;
            border-radius: 14px;
            flex: 1;
            min-width: 150px;
            border: 1px solid var(--border);
            position: relative;
            overflow: hidden;
        }
        .stat-card::before {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0; height: 3px;
            background: linear-gradient(90deg, var(--blue), var(--magenta));
        }
        .stat-card h3 { margin: 0 0 8px; color: var(--muted); font-size: 0.95em; }
        .stat-number {
            font-size: 2.2em;
            font-weight: 700;
            background: linear-gradient(90deg, var(--blue-bright), #c084fc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .card {
            background: var(--panel);
            backdrop-filter: blur(10px);
            padding: 28px;
            border-radius: 14px;
            border: 1px solid var(--border);
            margin-bottom: 24px;
            overflow-x: auto;
        }
        select, button {
            padding: 12px 18px;
            border-radius: 10px;
            border: 1px solid var(--border);
            font-family: inherit;
            font-weight: 600;
            background: rgba(5, 10, 24, 0.9);
            color: var(--text);
        }
        button {
            background: linear-gradient(90deg, #2563eb, #7c3aed);
            color: white;
            border: none;
            cursor: pointer;
            font-weight: 700;
        }
        table { width: 100%; border-collapse: collapse; margin-top: 12px; min-width: 640px; }
        th, td { padding: 12px; text-align: left; border-bottom: 1px solid var(--border); }
        th { color: var(--muted); text-transform: uppercase; font-size: 0.78em; }
        .status-badge {
            background: rgba(59,130,246,0.18);
            color: var(--blue-bright);
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 0.8em;
            font-weight: 700;
        }
        code { font-family: 'JetBrains Mono', monospace; background: rgba(5,10,24,0.9); padding: 2px 6px; border-radius: 4px; }
        @media (max-width: 900px) {
            .menu-toggle { display: block; }
            .sidebar {
                transform: translateX(-105%);
                transition: transform 0.25s ease;
                height: 100%;
            }
            .sidebar.open { transform: translateX(0); }
            .sidebar a.logout { position: static; margin-top: 30px; }
            .content { margin-left: 0; padding: 70px 16px 24px; }
        }
    </style>
</head>
<body>
    <button class="menu-toggle" type="button" onclick="document.querySelector('.sidebar').classList.toggle('open')">Menu</button>
    <div class="sidebar">
        <h2>ZUPERMING</h2>
        <a href="/admin" class="active">Dashboard</a>
        <a href="/admin/script">Script · Premium</a>
        <a href="/admin/script/sp">Script · Service Provider</a>
        <a href="/admin/update">Ping Update</a>
        <a href="/admin/logout" class="logout">Logout</a>
    </div>

    <div class="content">
        <h1 style="margin-top:0;">Overview</h1>

        <div class="stats-container">
            <div class="stat-card">
                <h3>Total Executions</h3>
                <div class="stat-number"><%= stats.total_executions %></div>
            </div>
            <div class="stat-card">
                <h3>HWID Resets</h3>
                <div class="stat-number"><%= stats.total_resets %></div>
            </div>
            <div class="stat-card">
                <h3>Online in Discord</h3>
                <div class="stat-number"><%= onlineMembers %></div>
            </div>
        </div>

        <div class="card">
            <h3 style="margin-top:0;">Generate License Key</h3>
            <p style="color:var(--muted);">Public API: <code><%= baseUrl %></code> · Duration kosong = Permanent</p>
            <form action="/admin/generate-key" method="POST" style="display:flex; gap:12px; flex-wrap:wrap;">
                <select name="product" required>
                    <% Object.values(products).forEach(function(p) { %>
                        <option value="<%= p.id %>"><%= p.name %></option>
                    <% }); %>
                </select>
                <select name="duration">
                    <option value="">Permanent</option>
                    <option value="1d">1 Day</option>
                    <option value="3d">3 Days</option>
                    <option value="7d">1 Week</option>
                    <option value="30d">1 Month</option>
                    <option value="lifetime">Lifetime</option>
                </select>
                <button type="submit">Generate Key</button>
            </form>
        </div>

        <div class="card">
            <h3 style="margin-top:0;">Recent Keys</h3>
            <table>
                <thead>
                    <tr>
                        <th>Key</th>
                        <th>Product</th>
                        <th>Duration</th>
                        <th>Status</th>
                        <th>Discord ID</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    <% keys.forEach(function(key) { %>
                        <tr>
                            <td><code><%= key.key_string %></code></td>
                            <td><%= key.product || 'premium' %></td>
                            <td><%= key.duration_label || key.duration %></td>
                            <td><span class="status-badge"><%= key.status %></span></td>
                            <td><%= key.discord_id || 'Not claimed' %></td>
                            <td style="color:var(--muted);"><%= key.created_at %></td>
                        </tr>
                    <% }); %>
                    <% if (keys.length === 0) { %>
                        <tr><td colspan="6" style="text-align:center; color:var(--muted); padding:24px;">No keys yet.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
