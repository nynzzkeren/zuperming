<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload Script - <%= product.name %></title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        body { 
            font-family: 'Inter', sans-serif; 
            background: #0f0c29; 
            color: #e2e8f0; 
            margin: 0; 
            padding: 0; 
        }
        .sidebar {
            width: 250px;
            height: 100vh;
            background: rgba(30, 30, 46, 0.95);
            position: fixed;
            border-right: 1px solid rgba(255,255,255,0.05);
            padding-top: 30px;
        }
        .sidebar h2 {
            text-align: center;
            background: -webkit-linear-gradient(#5865F2, #00f2fe);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 40px;
        }
        .sidebar a {
            display: block;
            padding: 15px 25px;
            color: #a0aec0;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s;
        }
        .sidebar a:hover, .sidebar a.active {
            background: rgba(88, 101, 242, 0.1);
            color: #5865F2;
            border-left: 4px solid #5865F2;
        }
        .sidebar a.logout {
            color: #ff5555;
            position: absolute;
            bottom: 20px;
            width: 100%;
            border: none;
        }
        .content {
            margin-left: 250px;
            padding: 40px;
        }
        .card {
            background: rgba(30, 30, 46, 0.8);
            padding: 30px;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.05);
        }
        .hint {
            color: #a0aec0;
            margin-bottom: 25px;
            line-height: 1.6;
        }
        .dropzone {
            border: 2px dashed rgba(88, 101, 242, 0.45);
            border-radius: 10px;
            padding: 28px;
            text-align: center;
            background: rgba(0,0,0,0.25);
            margin-bottom: 18px;
        }
        .dropzone input[type="file"] {
            color: #e2e8f0;
            max-width: 100%;
        }
        .or {
            text-align: center;
            color: #718096;
            margin: 18px 0;
            font-weight: 600;
            font-size: 0.9em;
        }
        textarea { 
            width: 100%; 
            height: 280px; 
            background-color: rgba(0,0,0,0.4); 
            color: #a0aec0; 
            border: 1px solid rgba(255,255,255,0.1); 
            padding: 15px; 
            font-family: 'Consolas', monospace; 
            border-radius: 8px;
            box-sizing: border-box;
            resize: vertical;
        }
        textarea:focus {
            outline: none;
            border-color: #5865F2;
        }
        button { 
            padding: 15px 30px; 
            background: linear-gradient(90deg, #5865F2, #4752C4); 
            color: white; 
            border: none; 
            border-radius: 8px; 
            cursor: pointer; 
            margin-top: 15px; 
            font-weight: 600;
            font-size: 1.1em;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(88, 101, 242, 0.4);
        }
        .msg { 
            padding: 15px; 
            background: rgba(43, 79, 43, 0.2); 
            color: #8f8; 
            border: 1px solid rgba(43, 79, 43, 0.5);
            border-radius: 8px; 
            margin-bottom: 25px; 
            font-weight: 600;
        }
        .err {
            padding: 15px; 
            background: rgba(120, 40, 40, 0.25); 
            color: #f88; 
            border: 1px solid rgba(180, 60, 60, 0.5);
            border-radius: 8px; 
            margin-bottom: 25px; 
            font-weight: 600;
        }
        .meta {
            margin-top: 28px;
            padding-top: 20px;
            border-top: 1px solid rgba(255,255,255,0.08);
            color: #a0aec0;
            font-size: 0.95em;
        }
        .meta strong { color: #e2e8f0; }
        code { background: rgba(0,0,0,0.4); padding: 2px 6px; border-radius: 4px; }
    </style>
</head>
<body>
    <div class="sidebar">
        <h2>Zuperming</h2>
        <a href="/admin">Dashboard</a>
        <a href="/admin/script" class="<%= product.id === 'premium' ? 'active' : '' %>">Script · Premium</a>
        <a href="/admin/script/sp" class="<%= product.id === 'service_provider' ? 'active' : '' %>">Script · Service Provider</a>
        <a href="/admin/logout" class="logout">Logout</a>
    </div>

    <div class="content">
        <h1 style="margin-top: 0; margin-bottom: 30px;"><%= product.name %> · Script</h1>

        <div class="card">
            <h3 style="margin-top:0;">Upload Protected Script</h3>
            <p class="hint">
                Obfus dulu (manual), lalu upload file <code>.lua</code>.
                Loader: <code><%= baseUrl %><%= product.loaderRoute %></code>
            </p>

            <% if (message) { %>
                <div class="msg"><%= message %></div>
            <% } %>
            <% if (error) { %>
                <div class="err"><%= error %></div>
            <% } %>

            <form action="<%= product.adminScriptPath %>" method="POST" enctype="multipart/form-data">
                <div class="dropzone">
                    <p style="margin: 0 0 12px; font-weight: 600;">Upload file .lua (sudah di-obfuscate)</p>
                    <input type="file" name="script_file" accept=".lua,.txt,text/plain">
                </div>

                <div class="or">— atau paste isi script obfus di bawah —</div>

                <textarea name="obfuscated_script" placeholder="-- paste obfuscated lua di sini..."></textarea>
                <button type="submit">Save / Update Script</button>
            </form>

            <% if (script) { %>
                <div class="meta">
                    <div><strong>Product:</strong> <%= product.name %></div>
                    <div><strong>Last update:</strong> <%= script.updated_at || '—' %></div>
                    <div><strong>Source:</strong> <%= script.raw_script || '—' %></div>
                    <div><strong>Size:</strong> <%= script.obfuscated_script ? script.obfuscated_script.length.toLocaleString() + ' chars' : '—' %></div>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
