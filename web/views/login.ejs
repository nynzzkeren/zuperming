<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zuperming Admin Login</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&family=Space+Grotesk:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #05070f;
            --panel: rgba(8, 12, 28, 0.82);
            --border: rgba(59, 130, 246, 0.28);
            --text: #e8eefc;
            --muted: #8b9bc4;
            --blue: #3b82f6;
            --blue-bright: #60a5fa;
            --magenta: #e11d8f;
            --danger: #f87171;
            --bg-image: url('https://cdn.discordapp.com/attachments/1482305764315107423/1532727199881363637/1783999829490.png?ex=6a6de6f1&is=6a6c9571&hm=0f7b740f2385acefcefdd24820f12617d61f6bd4158355a494e856172da7bbd5');
        }
        body {
            font-family: 'Space Grotesk', sans-serif;
            background:
                linear-gradient(135deg, rgba(5,7,15,0.88), rgba(8,18,48,0.82), rgba(20,8,28,0.88)),
                var(--bg-image) center / cover no-repeat fixed;
            color: var(--text);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .login-box {
            background: var(--panel);
            backdrop-filter: blur(14px);
            padding: 40px;
            border-radius: 16px;
            width: 360px;
            border: 1px solid var(--border);
            text-align: center;
            box-shadow: 0 24px 60px rgba(0,0,0,0.55), 0 0 40px rgba(59,130,246,0.12);
        }
        h2 {
            margin: 0 0 24px;
            font-family: 'Orbitron', sans-serif;
            background: linear-gradient(90deg, var(--blue-bright), #a78bfa, var(--magenta));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 700;
            letter-spacing: 0.04em;
        }
        input {
            padding: 12px 14px;
            margin: 0 0 16px;
            width: 100%;
            box-sizing: border-box;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: rgba(5, 10, 24, 0.85);
            color: var(--text);
            outline: none;
        }
        input:focus { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(59,130,246,0.15); }
        button {
            padding: 12px;
            width: 100%;
            background: linear-gradient(90deg, #2563eb, #7c3aed);
            color: white;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 700;
            font-family: inherit;
        }
        button:hover { filter: brightness(1.08); }
        .error {
            color: var(--danger);
            margin-bottom: 14px;
            background: rgba(248,113,113,0.1);
            padding: 10px;
            border-radius: 8px;
            border: 1px solid rgba(248,113,113,0.3);
        }
    </style>
</head>
<body>
    <div class="login-box">
        <h2>ZUPERMING</h2>
        <% if (error) { %><div class="error"><%= error %></div><% } %>
        <form action="/admin/login" method="POST">
            <input type="password" name="password" placeholder="Enter Admin Password" required>
            <button type="submit">Authenticate</button>
        </form>
    </div>
</body>
</html>
