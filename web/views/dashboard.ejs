<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zuperming Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #0a0a0a;
            --surface: #141414;
            --surface-hover: #1f1f1f;
            --border: #2a2a2a;
            --text: #ffffff;
            --muted: #a0a0a0;
            --primary: #ffffff;
            --primary-invert: #000000;
        }
        * { box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg);
            color: var(--text);
            margin: 0;
            min-height: 100vh;
            display: flex;
        }
        .sidebar {
            width: 260px;
            background: var(--surface);
            border-right: 1px solid var(--border);
            padding: 30px 0;
            display: flex;
            flex-direction: column;
            position: fixed;
            height: 100vh;
        }
        .sidebar h2 {
            text-align: center;
            font-weight: 700;
            letter-spacing: 2px;
            margin-bottom: 40px;
            font-size: 1.2rem;
            text-transform: uppercase;
        }
        .sidebar a {
            display: block;
            padding: 16px 30px;
            color: var(--muted);
            text-decoration: none;
            font-weight: 500;
            transition: all 0.2s;
            cursor: pointer;
        }
        .sidebar a:hover, .sidebar a.active {
            color: var(--text);
            background: var(--surface-hover);
            border-left: 3px solid var(--primary);
        }
        .sidebar .logout {
            margin-top: auto;
            color: #ff4d4d;
        }
        
        .main-content {
            margin-left: 260px;
            padding: 40px;
            flex: 1;
            max-width: calc(100vw - 260px);
        }
        
        .tab-content { display: none; }
        .tab-content.active { display: block; animation: fadeIn 0.3s ease; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        .header { margin-bottom: 40px; }
        .header h1 { margin: 0; font-size: 2rem; font-weight: 600; }
        
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; margin-bottom: 40px; }
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 24px;
        }
        .card h3 { margin: 0 0 10px 0; color: var(--muted); font-size: 0.9rem; font-weight: 500; text-transform: uppercase; }
        .card .value { font-size: 2.5rem; font-weight: 700; }
        
        .table-container {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            overflow-x: auto;
            margin-bottom: 30px;
        }
        table { width: 100%; border-collapse: collapse; text-align: left; }
        th, td { padding: 16px 20px; border-bottom: 1px solid var(--border); }
        th { color: var(--muted); font-weight: 500; font-size: 0.85rem; text-transform: uppercase; }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: var(--surface-hover); }
        
        .badge {
            background: #2a2a2a;
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 0.8rem;
            font-weight: 500;
        }
        
        input, select, button {
            padding: 12px 16px;
            background: var(--bg);
            border: 1px solid var(--border);
            color: var(--text);
            border-radius: 6px;
            font-family: inherit;
            font-size: 0.9rem;
        }
        button {
            background: var(--primary);
            color: var(--primary-invert);
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: opacity 0.2s;
        }
        button:hover { opacity: 0.9; }
        
        .form-row { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 20px; }
        code { background: #2a2a2a; padding: 2px 6px; border-radius: 4px; font-family: monospace; }
    </style>
</head>
<body>

    <div class="sidebar">
        <h2>Zuperming</h2>
        <a class="nav-link active" onclick="switchTab('dashboard', this)">Dashboard</a>
        <a class="nav-link" onclick="switchTab('projects', this)">Projects</a>
        <a class="nav-link" onclick="switchTab('users', this)">Users</a>
        <a class="nav-link" onclick="switchTab('keys', this)">Keys</a>
        <a href="/admin/logout" class="logout">Logout</a>
    </div>

    <div class="main-content">
        
        <!-- DASHBOARD TAB -->
        <div id="tab-dashboard" class="tab-content active">
            <div class="header">
                <h1>Overview</h1>
                <p style="color:var(--muted)">Welcome back, <%= username %>.</p>
            </div>
            <div class="grid">
                <div class="card">
                    <h3>Total Executions</h3>
                    <div class="value"><%= stats.total_executions %></div>
                </div>
                <div class="card">
                    <h3>Total HWID Resets</h3>
                    <div class="value"><%= stats.total_resets %></div>
                </div>
                <div class="card">
                    <h3>Online Members</h3>
                    <div class="value"><%= onlineMembers %></div>
                </div>
            </div>
        </div>

        <!-- PROJECTS TAB -->
        <div id="tab-projects" class="tab-content">
            <div class="header">
                <h1>Projects (Games)</h1>
            </div>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Game Name</th>
                            <th>Game ID</th>
                            <th>Plan</th>
                            <th>Status</th>
                            <th>Active Players</th>
                            <th>Last Script Update</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% games.forEach(g => { %>
                            <tr>
                                <td><strong><%= g.name %></strong></td>
                                <td><code><%= g.roblox_game_id %></code></td>
                                <td><span class="badge"><%= g.product %></span></td>
                                <td>
                                    <form action="/admin/game/status" method="POST" style="display:flex; gap:8px;">
                                        <input type="hidden" name="game_id" value="<%= g.id %>">
                                        <select name="status" style="padding: 6px; font-size: 0.8rem;" onchange="this.form.submit()">
                                            <option value="Working Script" <%= g.status === 'Working Script' ? 'selected' : '' %>>🟢 Working Script</option>
                                            <option value="Needs Update" <%= g.status === 'Needs Update' ? 'selected' : '' %>>🟠 Needs Update</option>
                                            <option value="Dead Script" <%= g.status === 'Dead Script' ? 'selected' : '' %>>🔴 Dead Script</option>
                                        </select>
                                    </form>
                                </td>
                                <td><%= g.active_players || 0 %></td>
                                <td style="color:var(--muted)"><%= g.last_script_update || 'Never' %></td>
                            </tr>
                        <% }) %>
                        <% if(games.length === 0) { %>
                            <tr><td colspan="5" style="text-align:center;color:var(--muted)">No projects found.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            <p style="color:var(--muted); font-size:0.9rem;">* Note: Project creation and script uploads are now fully handled directly via the Discord Bot (<code>/managegames</code>).</p>
        </div>

        <!-- USERS TAB -->
        <div id="tab-users" class="tab-content">
            <div class="header">
                <h1>Users</h1>
            </div>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Discord ID</th>
                            <th>Executions</th>
                            <th>HWID Resets</th>
                            <th>Last Executor</th>
                            <th>Last Warned</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(u => { %>
                            <tr>
                                <td><code><%= u.discord_id %></code></td>
                                <td><%= u.total_executions || 0 %></td>
                                <td><%= u.hwid ? 'Bound' : 'Not Bound' %> (Resets logged in global stats)</td>
                                <td><span class="badge"><%= u.last_executor_name || 'Unknown' %></span></td>
                                <td style="color:var(--muted)"><%= u.last_executor_warn || '-' %></td>
                            </tr>
                        <% }) %>
                        <% if(users.length === 0) { %>
                            <tr><td colspan="5" style="text-align:center;color:var(--muted)">No users recorded yet.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- KEYS TAB -->
        <div id="tab-keys" class="tab-content">
            <div class="header">
                <h1>Keys Management</h1>
            </div>
            <div class="card" style="margin-bottom: 30px;">
                <form action="/admin/generate-key" method="POST" class="form-row">
                    <select name="product" required>
                        <% Object.values(products).forEach(function(p) { %>
                            <option value="<%= p.id %>"><%= p.name %></option>
                        <% }); %>
                    </select>
                    <select name="duration">
                        <option value="">Permanent</option>
                        <option value="1d">1 Day</option>
                        <option value="3d">3 Days</option>
                        <option value="7d">1 Week</option>
                        <option value="30d">1 Month</option>
                    </select>
                    <button type="submit">Generate Key</button>
                </form>
            </div>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Key</th>
                            <th>Product</th>
                            <th>Duration</th>
                            <th>Status</th>
                            <th>Discord ID</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% keys.forEach(function(key) { %>
                            <tr>
                                <td><code><%= key.key_string %></code></td>
                                <td><%= key.product || 'premium' %></td>
                                <td><%= key.duration_label || key.duration %></td>
                                <td><span class="badge"><%= key.status %></span></td>
                                <td><%= key.discord_id || '-' %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <script>
        function switchTab(tabId, el) {
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            document.getElementById('tab-' + tabId).classList.add('active');
            
            document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
            if(el) el.classList.add('active');
        }
    </script>
</body>
</html>
